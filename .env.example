# TravelMate local environment variables
# Copy this file to .env and fill in local values.

# MySQL root password used by Spring datasource.
# If your local MySQL root account has no password, leave this empty.
DB_PASSWORD=

# DeepSeek API key. Optional; without a real key, AI features fall back to templates.
DEEPSEEK_API_KEY=sk-demo-placeholder

# Optional DeepSeek settings.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high
