# TravelMate 本地环境变量模板
# 首次运行前请复制为 .env，并按本机环境填写实际值。

# 当前运行环境。根目录 .env 仅供本机开发与 Docker Compose 使用。
APP_ENV=local
SERVER_PORT=8080
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_URL=http://localhost:8080

# MySQL 连接。默认连接本机 travelmate 数据库；容器环境应全部显式配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=travelmate
DB_USERNAME=root
DB_PASSWORD="your_mysql_root_password"

# 数据库版本迁移默认开启；仅在故障排查时临时设为 false。
FLYWAY_ENABLED=true

# Redis 连接。无密码的本地 Redis 可保持 REDIS_PASSWORD 为空。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT 签名密钥必须是至少 32 个随机字节的 Base64 文本。
# 可用 PowerShell 生成：Convert.ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET="replace_with_base64_encoded_random_secret"
JWT_ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_SECURE=false

# DeepSeek API Key。未配置真实密钥时，AI 行程和客服会自动降级为本地模板。
DEEPSEEK_API_KEY="sk-demo-placeholder"

# DeepSeek 可选配置。一般保持默认即可，需要切换网关、模型或推理强度时再修改。
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=high      

# 管理员初始化入口默认关闭；仅在首次创建管理员且确认系统中不存在管理员时临时开启。
ADMIN_REGISTER_ENABLED=false
ADMIN_REGISTER_SECRET="replace_with_random_admin_registration_secret"
ADMIN_REGISTER_EXPIRES_AT=""

# 图片存储。本机开发默认写入本地 uploads 目录。
# 容器联调或服务器使用 S3 兼容存储时，将 STORAGE_TYPE 改为 s3 并填写下列参数。
STORAGE_TYPE=local
UPLOAD_DIR=uploads
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=travelmate
S3_ACCESS_KEY="replace_with_s3_access_key"
S3_SECRET_KEY="replace_with_s3_secret_key"
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/travelmate
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=19001
