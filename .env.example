# ============================================
# TravelMate 环境配置文件模板
# 复制为 .env 并填入真实值:
#   cp .env.example .env
# ============================================
# 加载环境变量:
#   Windows PowerShell: .\setup.ps1
#   Linux/Mac:         source .env
# ============================================

# 数据库密码 (MySQL root 密码)
DB_PASSWORD="your_database_password_here"

# DeepSeek API 密钥 (AI 功能需要)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
