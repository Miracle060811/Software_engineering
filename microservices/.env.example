MYSQL_ROOT_PASSWORD=replace_with_local_mysql_root_password
IDENTITY_DB_PASSWORD=replace_with_identity_database_password
TRAFFIC_DB_PASSWORD=replace_with_traffic_database_password
LOCAL_DB_PASSWORD=replace_with_local_database_password
AI_DB_PASSWORD=replace_with_ai_database_password
JWT_SECRET=replace_with_base64_encoded_random_secret
INTERNAL_SERVICE_TOKEN=replace_with_random_internal_service_token
AI_SERVICE_URL=http://host.docker.internal:8084

# 仅用于本地 Compose 端口映射，可按需调整。
IDENTITY_PORT=8081
TRAFFIC_PORT=8082
LOCAL_PORT=8083
AI_PORT=8084
IDENTITY_MYSQL_PORT=3307
TRAFFIC_MYSQL_PORT=3308
LOCAL_MYSQL_PORT=3309
AI_MYSQL_PORT=3310
