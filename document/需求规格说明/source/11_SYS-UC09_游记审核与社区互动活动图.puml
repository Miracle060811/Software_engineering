@startuml
|用户|
start
:编辑并提交游记;
|TravelMate|
if (图片上传成功?) then (是)
  if (内容命中禁止规则?) then (是)
    :拒绝发布并说明原因;
    stop
  else (否)
    :保存为待审核;
  endif
else (否)
  :返回上传失败;
  stop
endif
|管理员|
if (审核结果?) then (驳回)
  |TravelMate|
  :保存驳回原因并通知用户;
  stop
else (通过)
  |TravelMate|
  :发布游记并通知用户;
endif
|用户|
if (互动类型?) then (点赞/收藏)
  |TravelMate|
  if (是否重复请求?) then (是)
    :返回当前状态;
  else (否)
    :保存或取消互动关系;
  endif
elseif (评论/回复)
  |TravelMate|
  if (内容和父评论合法?) then (是)
    :保存树状评论;
  else (否)
    :拒绝非法评论;
  endif
else (关注/取消关注)
  |TravelMate|
  if (目标不是自己且存在?) then (是)
    :幂等更新关注关系;
  else (否)
    :拒绝自关注或无效目标;
  endif
endif
stop
@enduml