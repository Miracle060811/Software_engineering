@startuml
start
if (用户操作?) then (注册)
  :提交注册信息;
  if (用户名可用且参数合法?) then (是)
    :创建账户并哈希保存密码;
    :签发 JWT;
  else (否)
    :返回注册失败原因;
    stop
  endif
else (登录)
  :提交登录信息;
  if (凭据正确且账号启用?) then (是)
    :签发 JWT;
  else (否)
    :返回登录失败原因;
    stop
  endif
endif
if (后续目标?) then (维护资料)
  :校验 Token 并更新资料;
elseif (修改密码)
  :校验旧密码并更新密码哈希;
else (访问受保护功能)
  if (Token 和权限有效?) then (是)
    :允许访问;
  else (否)
    :返回 401/403;
    stop
  endif
endif
:返回可验证结果;
stop
@enduml