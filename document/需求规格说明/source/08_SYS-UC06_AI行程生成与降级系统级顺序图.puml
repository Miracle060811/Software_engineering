@startuml
actor 用户 as U
participant TravelMate as T
participant "外部 AI 服务" as A
U -> T : 提交目的地、日期、预算和偏好
T -> T : 校验参数与登录状态
alt 参数非法或未登录
  T --> U : 返回明确错误
else 参数有效
  alt AI 配置可用
    T -> A : 请求结构化行程
    alt AI 正常返回合法 JSON
      A --> T : 行程 JSON
      T -> T : 校验结构并匹配站内资源
      opt 部分地点无法匹配
        T -> T : 保留地点文本并提供候选资源
      end
    else 超时或 JSON 非法
      A --> T : 超时或非法响应
      T -> T : 生成本地降级模板
    end
  else AI Key 缺失
    T -> T : 生成本地降级模板
  end
  T -> T : 保存行程及降级原因
  T --> U : 返回结构化行程卡片
end
@enduml