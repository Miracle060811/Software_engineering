@startuml
start
:搜索酒店并查看房型;
:选择日期、房型、数量和入住人;
if (日期和入住信息合法?) then (是)
  if (已选择无效优惠券?) then (是)
    :返回优惠校验失败;
    stop
  endif
else (否)
  :返回参数错误;
  stop
endif
if (Redis 可用?) then (是)
  :Redis 预减库存;
else (否)
  :降级到数据库库存校验;
endif
if (数据库原子扣减成功?) then (是)
  :创建待支付酒店订单;
else (否)
  :返回库存不足并修正缓存;
  stop
endif
if (按时完成模拟支付?) then (是)
  :更新为已支付;
else (否)
  :关闭订单并回补两级库存;
  stop
endif
if (后续操作?) then (入住完成)
  :更新为已完成;
else (取消或退款)
  if (状态允许且未重复?) then (是)
    :取消/退款并回补两级库存;
  else (否)
    :拒绝非法或重复操作;
  endif
endif
stop
@enduml