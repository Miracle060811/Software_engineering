@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor 游客 as Guest
actor 已登录用户 as User
actor 管理员 as Admin
actor "外部 AI 服务" as AI

rectangle "TravelMate 系统边界" {
  usecase "UC01\n账户与个人资料安全管理" as UC01
  usecase "UC02\n大交通查询、预订与订单履约" as UC02
  usecase "UC03\n酒店查询、订房与订单处理" as UC03
  usecase "UC04\n景点及本地游产品预订" as UC04
  usecase "UC05\n履约后评价、回复与举报处理" as UC05
  usecase "UC06\nAI 行程生成、匹配与保存" as UC06
  usecase "UC07\nAI 客服多轮对话" as UC07
  usecase "UC08\n通知中心与站内私信" as UC08
  usecase "UC09\n游记发布审核与社区互动" as UC09
  usecase "UC10\n管理后台业务运营" as UC10
  usecase "UC11\n内容安全与系统可观测" as UC11
}

Guest --> UC01
Guest --> UC04
User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09
Admin --> UC05
Admin --> UC09
Admin --> UC10
Admin --> UC11
AI --> UC06
AI --> UC07
UC02 ..> UC01 : <<include>> 身份校验
UC03 ..> UC01 : <<include>> 身份校验
UC04 ..> UC01 : <<include>> 提交订单时校验身份
@enduml