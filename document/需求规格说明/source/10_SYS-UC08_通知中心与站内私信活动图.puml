@startuml
start
if (触发来源?) then (业务事件)
  :核心业务完成;
  if (通知写入成功?) then (是)
    :生成未读通知;
    :用户查询通知列表和未读数;
    if (用户操作?) then (标记已读)
      :更新已读状态;
    else (删除)
      :校验归属后删除通知;
    endif
  else (否)
    :记录通知失败但不回滚核心交易;
  endif
else (主动私信)
  :用户选择联系人;
  if (接收者存在且消息非空?) then (是)
    :保存并发送私信;
    :双方查询会话;
    if (请求者是会话参与者?) then (是)
      :返回按时间排序的消息;
    else (否)
      :拒绝越权读取;
    endif
  else (否)
    :拒绝发送;
  endif
endif
stop
@enduml