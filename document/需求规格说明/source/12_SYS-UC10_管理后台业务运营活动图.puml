@startuml
start
if (RBAC 校验通过?) then (是)
else (否)
  :返回 403;
  stop
endif
if (选择运营任务?) then (资源维护)
  :新增、修改、启停或批量导入;
  if (导入数据合法?) then (是)
    if (删除对象被业务引用?) then (是)
      :拒绝物理删除或执行软删除;
    else (否)
      :保存资源变更;
    endif
  else (否)
    :返回错误行摘要;
    stop
  endif
elseif (用户管理)
  :查询并启用或禁用用户;
else (订单管理)
  :查询订单并审核退款;
  if (状态允许且未重复审核?) then (是)
    :保存审核结果;
  else (否)
    :拒绝非法或重复操作;
    stop
  endif
endif
:写入审计日志;
:返回处理结果;
stop
@enduml