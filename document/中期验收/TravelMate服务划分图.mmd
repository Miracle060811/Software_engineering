            ID["A. SVC-IDENTITY 身份与用户服务<br/>账号｜资料｜关注｜常用旅客<br/>/user/**｜/api/user/**｜/api/follow/**｜/api/passenger/**"]
            TRAFFIC["B. SVC-TRAFFIC 交通与订单服务<br/>航班｜火车｜候补｜交通订单<br/>/api/flight/**｜/api/train/**｜/api/order/**"]
            LOCAL["C. SVC-LOCAL 酒店景点与权益服务<br/>酒店｜景点｜评价｜优惠券｜本地游<br/>/api/hotel/**｜/api/attraction/**｜/api/coupon/**"]
        end
        subgraph ROW2[ ]
            direction LR
            AI["D. SVC-AI AI 与消息服务<br/>AI 行程｜AI 对话｜通知｜私信<br/>/api/ai/**｜/api/notification/**｜/api/private-message/**"]
            COMMUNITY["E. SVC-COMMUNITY 社区内容服务<br/>帖子｜评论｜点赞收藏｜图片素材<br/>/api/post/**｜/api/comment/**｜/api/like/**｜/api/file/**"]
            OPS["F. SVC-OPS 运营管理服务<br/>审核编排｜管理命令｜日志｜敏感词<br/>/api/admin/**"]
        end
        CONTRACT["跨服务契约层<br/>内部 REST：同步查询/命令｜领域事件：通知/审核<br/>超时｜幂等｜重试｜补偿"]
    end
    subgraph DATA[三、数据与外部依赖层]
